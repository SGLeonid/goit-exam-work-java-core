<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="600.0" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.forestwizard.goitjavacoreexamproject.ui.WikiSearchController">
   <children>
      <ToolBar prefHeight="40.0" prefWidth="200.0">
        <items>
          <Button fx:id="historyButton" maxWidth="80.0" minWidth="80.0" mnemonicParsing="false" onAction="#onHistoryButtonClick" prefHeight="25.0" prefWidth="80.0" text="History" />
            <Button fx:id="exitButton" maxWidth="80.0" minWidth="80.0" mnemonicParsing="false" onAction="#onExitButtonClick" prefWidth="80.0" text="Exit" />
        </items>
      </ToolBar>
      <VBox fx:id="workArea" alignment="TOP_RIGHT" prefHeight="200.0" prefWidth="100.0" VBox.vgrow="ALWAYS">
         <children>
            <TextField fx:id="searchField" promptText="Search ...">
               <VBox.margin>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </VBox.margin>
            </TextField>
            <Button mnemonicParsing="false" onMouseClicked="#onSearchButtonClick" prefHeight="25.0" prefWidth="80.0" text="Search">
               <VBox.margin>
                  <Insets left="15.0" right="15.0" />
               </VBox.margin>
            </Button>
            <ListView fx:id="articleList" onMouseClicked="#onArticleListClick" prefHeight="243.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </VBox.margin>
            </ListView>
         </children>
      </VBox>
   </children>
</VBox>
